<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Fatorial"/>
        <attribute name="authors" value="Estudante"/>
        <attribute name="about" value="Calcula o fatorial de um número inteiro positivo. Usa if/else para validar entrada e while para o cálculo."/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, fat, i" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um número inteiro não-negativo:&quot;" newline="True"/>
            <input variable="n"/>
            <if expression="n &lt; 0">
                <then>
                    <output expression="&quot;Entrada inválida (negativo).&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="fat" expression="1"/>
                    <assign variable="i" expression="1"/>
                    <while expression="i &lt;= n">
                        <assign variable="fat" expression="fat * i"/>
                        <assign variable="i" expression="i + 1"/>
                    </while>
                    <output expression="&quot;Fatorial = &quot;" newline="False"/>
                    <output expression="fat" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
